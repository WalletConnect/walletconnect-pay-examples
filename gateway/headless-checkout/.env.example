# Copy to .env.local and fill in.

# Reown AppKit project ID (client-side, exposed to the browser).
# Get one at https://dashboard.reown.com
NEXT_PUBLIC_APPKIT_PROJECT_ID=

# WalletConnect Pay Engine base URL (server-side). Defaults to staging when unset.
WCP_API_URL=https://staging.api.pay.walletconnect.org

# Engine wallet API key (server-side, SECRET — never exposed to the browser).
WCP_WALLET_API_KEY=
